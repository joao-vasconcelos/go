{
	"compilerOptions": {
		"allowJs": true,
		"baseUrl": ".",
		"esModuleInterop": true,
		"incremental": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"lib": [
			"dom",
			"dom.iterable",
			"esnext"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"outDir": "build",
		"paths": {
			"@/authentication/*": ["authentication/*"],
			"@/components/*": ["components/*"],
			"@/contexts/*": ["contexts/*"],
			"@/forms/*": ["forms/*"],
			"@/helpers/*": ["helpers/*"],
			"@/hooks/*": ["hooks/*"],
			"@/schemas/*": ["schemas/*"],
			"@/scripts/*": ["scripts/*"],
			"@/services/*": ["services/*"],
			"@/styles/*": ["styles/*"],
			"@/translations/*": ["translations/*"]
		},
		"plugins": [
			{
				"name": "next"
			}
		],
		"resolveJsonModule": true,
		"rootDir": ".",
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": false,
		"strictNullChecks": true,
		"target": "ES6"
	},
	"include": [
		"next-env.d.ts",
		".next/types/**/*.ts",
		"**/*.ts",
		"**/*.tsx"
	],
	"exclude": [
		"**/node_modules",
		"**/.*/",
		"**/build/",
		"**/.next/"
	]
}
